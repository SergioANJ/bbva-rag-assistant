APP_ENV=dev
LOG_LEVEL=INFO

# ---------- Scraping ----------
SCRAPE_SITEMAP_URL=https://www.bancolombia.com/sitemap-index.xml
SCRAPE_ALLOWED_DOMAINS=["www.bancolombia.com","valores.bancolombia.com"]
SCRAPE_EXCLUDE_PATTERNS=["simulador","llamanos","chatea-con-nosotros","-viejo","historias-que-transforman","/src/"]
SCRAPE_SOFT404_PATHS=["/personas"]
SCRAPE_DOWNLOAD_DELAY=1.5
SCRAPE_MAX_PAGES=0
SCRAPE_HTTP_CACHE=true

# ---------- Cleaning ----------
CLEAN_BOILERPLATE_MIN_DOC_FREQ=0.10
CLEAN_MIN_CHARS=200

# ---------- Chunking ----------
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
CHUNK_MIN_CHARS=100

# ---------- OpenAI ----------
OPENAI_API_KEY=sk-your-key-here

# ---------- Embeddings ----------
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=100
SPARSE_MODEL=Qdrant/bm25
SPARSE_LANGUAGE=spanish

# ---------- Qdrant ----------
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=bancolombia_chunks

# ---------- Retrieval ----------
RETRIEVAL_STRATEGY=hybrid
RETRIEVAL_TOP_K=15

# ---------- Reranker ----------
RERANKER_ENABLED=true
RERANKER_MODEL=jinaai/jina-reranker-v2-base-multilingual
RERANK_TOP_N=5
RELEVANCE_THRESHOLD=0.0
MAX_QUERY_REWRITES=1

# ---------- LLM ----------
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=800
LLM_TIMEOUT_SECONDS=30